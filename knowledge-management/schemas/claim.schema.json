{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/879501250/relationship-compass/schemas/claim.schema.json",
  "title": "Relationship Compass Candidate Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id", "canonical_claim", "source_id", "source_anchor", "claim_type",
    "claim_evidence", "confidence", "applicable_when", "not_applicable_when",
    "risk_of_misuse", "relation_to_existing", "proposed_destination"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^claim-[0-9a-f]{16}$"},
    "canonical_claim": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "pattern": "^src-[a-z0-9][a-z0-9-]{2,63}$"},
    "source_anchor": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["empirical", "theoretical", "clinical", "author_experience", "practical_heuristic", "ethical_norm"]},
    "claim_evidence": {"enum": ["A", "B", "C", "D", "unknown"]},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "applicable_when": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "not_applicable_when": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_of_misuse": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "relation_to_existing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "claim_ids"],
      "properties": {
        "type": {"enum": ["new", "duplicate", "extends", "conflicts"]},
        "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^claim-[0-9a-f]{16}$"}}
      }
    },
    "proposed_destination": {"enum": ["relationship-start", "conversation", "attraction", "intimacy", "boundaries", "conflict-and-repair", "personal-growth"]},
    "last_reviewed_at": {"type": "string", "format": "date-time"},
    "review_after": {"type": "string", "format": "date-time"}
  }
}
